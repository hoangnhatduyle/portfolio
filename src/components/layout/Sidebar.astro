---
import { profile } from '../../lib/content';
import { NAV_ITEMS } from '../../lib/nav';
import { withBase } from '../../lib/url';
---

<aside class="sidebar" aria-label="Site">
  <a class="brand" href="#top">
    <span class="brand__name">{profile.name}</span>
    <span class="brand__role">{profile.role}</span>
  </a>

  <nav aria-label="Primary">
    <ul>
      {NAV_ITEMS.map((item) => (
        <li>
          <a class="nav-link" href={`#${item.id}`} data-nav={item.id}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="actions">
    <button type="button" class="btn btn--accent" data-open-contact>
      Get in touch
    </button>
    <a
      class="btn btn--ghost"
      href={withBase(profile.links.resume)}
      target="_blank"
      rel="noopener noreferrer"
    >
      Résumé (PDF)
    </a>
    <p class="social">
      <a href={profile.links.github} target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
      <span aria-hidden="true">·</span>
      <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
    </p>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    width: var(--sidebar-w);
    background: var(--side);
    color: var(--side-text);
    overflow-y: auto;
  }
  .brand {
    display: block;
    padding: 1.75rem 1.25rem 1.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    text-decoration: none;
  }
  .brand__name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .brand__role {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--text-sm);
    color: var(--accent-on-dark);
  }
  nav {
    padding-block: 0.75rem;
  }
  .nav-link {
    display: block;
    padding: 0.75rem 1.25rem 0.75rem calc(1.25rem - 3px);
    border-left: 3px solid transparent;
    color: var(--side-mute);
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .nav-link:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.05);
  }
  .nav-link[aria-current='location'] {
    color: #fff;
    font-weight: 600;
    border-left-color: var(--accent);
    background: rgb(255 255 255 / 0.08);
  }
  .actions {
    display: grid;
    gap: 0.6rem;
    margin-top: auto;
    padding: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }
  .actions .btn--ghost {
    color: var(--side-text);
  }
  .social {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    color: var(--side-mute);
  }
  .social a {
    text-decoration: none;
  }
  .social a:hover {
    color: #fff;
    text-decoration: underline;
  }
  @media (max-width: 991.98px) {
    .sidebar {
      display: none;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import SectionBanner from '../ui/SectionBanner.astro';
import { testimonials } from '../../lib/content';
import { image } from '../../lib/assets';
---

<section id="feedback" aria-labelledby="feedback-heading">
  <SectionBanner id="feedback" title="Feedback" />
  <div class="container body">
    <ul class="grid">
      {testimonials.map((t) => (
        <li class="card reveal">
          <div class="top">
            <span class="mark" aria-hidden="true">
              “
            </span>
            <Image class="org" src={image(t.logo)} alt="" height={28} loading="lazy" />
          </div>
          <blockquote>
            <p>{t.quote}</p>
          </blockquote>
          <figure class="who">
            <Image
              class="photo"
              src={image(t.photo)}
              alt=""
              width={56}
              height={56}
              loading="lazy"
            />
            <figcaption>
              <strong>{t.name}</strong>
              <span>
                {t.role}, {t.org}
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .body {
    padding-block: 2.25rem var(--space-section);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16.5rem), 1fr));
    gap: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.6rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }
  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: -0.5rem;
  }
  .mark {
    height: 2rem;
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 1;
    color: var(--accent);
  }
  blockquote p {
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  .who {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.85rem;
    margin: auto 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .photo {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
  }
  figcaption {
    display: grid;
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--ink-mute);
  }
  figcaption strong {
    color: var(--ink);
    font-size: 0.95rem;
  }
  .org {
    width: auto;
    max-width: 6rem;
    height: 1.75rem;
    object-fit: contain;
    opacity: 0.85;
  }
</style>

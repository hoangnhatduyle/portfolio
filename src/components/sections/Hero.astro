---
import { Image } from 'astro:assets';
import portrait from '../../assets/profile.jpg';
import { experience, profile, research } from '../../lib/content';
import { computeStats } from '../../lib/format';
import { withBase } from '../../lib/url';

const stats = computeStats(profile, experience, research);
const statItems = [
  { value: stats.years, label: 'Years building software' },
  { value: String(stats.employers), label: 'Industry employers' },
  { value: stats.customers, label: 'Customers served' },
  { value: String(stats.papers), label: 'Papers under review' },
];
---

<section id="top" class="hero" aria-labelledby="hero-heading">
  <div class="hero__portrait">
    <Image
      src={portrait}
      alt={`Portrait of ${profile.name}`}
      widths={[480, 760, 1000]}
      sizes="(max-width: 991px) 100vw, 46vw"
      loading="eager"
      fetchpriority="high"
      format="webp"
    />
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">
        M.S. Computer Science · University of Cincinnati · CincySI Lab
      </p>
      <h1 id="hero-heading">
        {profile.headline} <span class="hero__accent">{profile.headlineAccent}</span>
      </h1>
      <p class="hero__summary">{profile.summary}</p>

      <ul class="hero__availability" aria-label="Currently seeking">
        <li>{profile.availability.research}</li>
        <li>{profile.availability.fullTime}</li>
      </ul>

      <div class="hero__cta">
        <button type="button" class="btn btn--accent" data-open-contact>
          Get in touch
        </button>
        <a
          class="btn btn--ghost"
          href={withBase(profile.links.resume)}
          target="_blank"
          rel="noopener noreferrer"
        >
          Résumé (PDF)
        </a>
      </div>
    </div>
  </div>

  <div class="hero__stats">
    <dl class="container stats">
      {statItems.map((s) => (
        <div class="stat">
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--side);
    color: #fff;
  }
  .hero__portrait {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: -1;
    width: min(52%, 720px);
  }
  .hero__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 38%),
      linear-gradient(to top, transparent 0%, #000 28%);
    mask-image: linear-gradient(to right, transparent 0%, #000 38%);
  }
  .hero__inner {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.75rem) clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
  }
  .hero__copy {
    max-width: 38rem;
  }
  .hero__eyebrow {
    color: var(--accent-on-dark);
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: var(--text-hero);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .hero__accent {
    color: var(--accent-on-dark);
  }
  .hero__summary {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: var(--text-lg);
    color: rgb(255 255 255 / 0.82);
  }
  .hero__availability {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.75rem;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    font-weight: 500;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__cta .btn--ghost {
    color: #fff;
  }
  /* The sidebar already carries these two buttons beside the hero; phones have no sidebar, so keep them there. */
  @media (min-width: 992px) {
    .hero__cta {
      display: none;
    }
  }
  .hero__stats {
    border-top: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(0 0 0 / 0.28);
    backdrop-filter: blur(6px);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-block: 0;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    padding: 1.1rem 1rem 1.1rem 0;
  }
  .stat + .stat {
    padding-left: 1.25rem;
    border-left: 1px solid rgb(255 255 255 / 0.14);
  }
  dt {
    font-size: var(--text-sm);
    color: var(--side-mute);
  }
  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
  }

  @media (max-width: 991.98px) {
    .hero__portrait {
      position: relative;
      inset: auto;
      width: 100%;
      height: clamp(240px, 52vw, 380px);
    }
    .hero__portrait :global(img) {
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 55%);
      mask-image: linear-gradient(to top, transparent 0%, #000 55%);
      object-position: 50% 18%;
    }
    .hero__inner {
      margin-top: -3rem;
      padding-top: 0;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid rgb(255 255 255 / 0.14);
    }
  }
</style>

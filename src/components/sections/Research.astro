---
import SectionBanner from '../ui/SectionBanner.astro';
import { research } from '../../lib/content';

const STATUS_LABEL = {
  'under-review': 'Under review',
  'in-preparation': 'In preparation',
} as const;
---

<section id="research" aria-labelledby="research-heading">
  <SectionBanner id="research" title="Research" />
  <div class="container body">
    <p class="intro">
      I work on multi-agent LLM systems at the CincySI Lab (University of Cincinnati): how to audit
      what agents claim, and how their confidence behaves as messages pass between them.
    </p>
    <ul class="grid">
      {research.map((r) => (
        <li class="card reveal">
          <p class="status">
            <span class="dot" aria-hidden="true" />
            {STATUS_LABEL[r.status]} · {r.venue}
          </p>
          <p class="topic">{r.topic}</p>
          <p class="note">Title withheld while under review.</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .body {
    padding-block: 2.25rem var(--space-section);
  }
  .intro {
    max-width: 44rem;
    font-size: var(--text-lg);
    color: var(--ink-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .topic {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .note {
    margin-top: auto;
    font-size: var(--text-sm);
    color: var(--ink-mute);
  }
</style>

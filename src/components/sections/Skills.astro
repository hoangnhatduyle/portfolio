---
import SectionBanner from '../ui/SectionBanner.astro';
import { skills } from '../../lib/content';
import { iconPath } from '../../lib/icons';
---

<section id="skills" aria-labelledby="skills-heading">
  <SectionBanner id="skills" title="Skills" />
  <div class="container body">
    <ul class="grid">
      {skills.map((tier) => (
        <li class={`tier tier--${tier.id} reveal`}>
          <h3>{tier.title}</h3>
          <p class="caption">{tier.caption}</p>
          <ul class="chips">
            {tier.items.map((item) => {
              const path = iconPath(item.icon);
              return (
                <li class="chip">
                  {path && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d={path} />
                    </svg>
                  )}
                  {item.name}
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .body {
    padding-block: 2.25rem var(--space-section);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }

  /* Same card language as Experience and Education: a red edge, white surface, soft shadow. */
  .tier {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  /* Daily is the one dark card: what I actually reach for first. */
  .tier--daily {
    background: var(--side);
    border-color: var(--side);
    border-left-color: var(--accent);
    color: #fff;
  }
  /* Earlier career recedes: no fill, no shadow, a grey edge. */
  .tier--earlier {
    background: transparent;
    border-left-color: var(--line-strong);
    box-shadow: none;
  }

  h3 {
    font-size: 1.4rem;
  }
  .caption {
    margin-top: 0.15rem;
    font-size: var(--text-sm);
    color: var(--ink-mute);
  }
  .tier--daily .caption {
    color: var(--side-mute);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.5;
    transition:
      transform var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .chip:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }
  .chip svg {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    fill: currentColor;
  }
  .tier--daily .chip {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.22);
  }
  .tier--daily .chip:hover {
    border-color: var(--accent-on-dark);
  }
  .tier--earlier .chip {
    background: transparent;
    color: var(--ink-soft);
    font-weight: 400;
  }
</style>

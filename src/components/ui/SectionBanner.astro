---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div class="banner">
  <div class="container">
    <h2 id={`${id}-heading`}>{title}</h2>
  </div>
</div>

<style>
  .banner {
    background: var(--banner);
    border-block: 1px solid var(--line);
  }
  h2 {
    position: relative;
    padding-block: 1.1rem 1.25rem;
    font-size: var(--text-banner);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h2::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 3rem;
    height: 3px;
    background: var(--accent);
  }
</style>
